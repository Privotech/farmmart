generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model animals {
  id            String           @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name          String           @db.VarChar(200)
  category      animals_category
  breed         String?          @db.VarChar(150)
  age           Int?
  weight        Decimal?         @db.Decimal(8, 2)
  price         Decimal          @db.Decimal(12, 2)
  description   String?          @db.Text
  images        String           @db.LongText
  status        animals_status   @default(AVAILABLE)
  location      String?          @db.VarChar(200)
  state         String?          @db.VarChar(100)
  is_negotiable Boolean          @default(false)
  view_count    Int              @default(0)
  seller_id     String           @db.VarChar(36)
  created_at    DateTime         @default(now()) @db.DateTime(0)
  updated_at    DateTime         @default(now()) @db.DateTime(0)
  users         users            @relation(fields: [seller_id], references: [id], onDelete: Cascade, map: "fk_animals_seller")
  cart          cart[]
  inquiries     inquiries[]
  orders        orders[]
  reviews       reviews[]

  @@index([category], map: "idx_animals_category")
  @@index([created_at], map: "idx_animals_created_at")
  @@index([price], map: "idx_animals_price")
  @@index([seller_id], map: "idx_animals_seller_id")
  @@index([state], map: "idx_animals_state")
  @@index([status], map: "idx_animals_status")
  @@fulltext([name, breed, description], map: "ft_animals_search")
}

model cart {
  id         String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  animal_id  String   @db.VarChar(36)
  quantity   Int      @default(1)
  created_at DateTime @default(now()) @db.DateTime(0)
  animals    animals  @relation(fields: [animal_id], references: [id], onDelete: Cascade, map: "fk_cart_animal")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_cart_user")

  @@unique([user_id, animal_id], map: "uq_cart_user_animal")
  @@index([animal_id], map: "fk_cart_animal")
  @@index([user_id], map: "idx_cart_user_id")
}

model inquiries {
  id                                 String           @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  sender_id                          String           @db.VarChar(36)
  receiver_id                        String           @db.VarChar(36)
  animal_id                          String           @db.VarChar(36)
  message                            String           @db.Text
  status                             inquiries_status @default(UNREAD)
  created_at                         DateTime         @default(now()) @db.DateTime(0)
  animals                            animals          @relation(fields: [animal_id], references: [id], onDelete: Cascade, map: "fk_inquiries_animal")
  users_inquiries_receiver_idTousers users            @relation("inquiries_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade, map: "fk_inquiries_receiver")
  users_inquiries_sender_idTousers   users            @relation("inquiries_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade, map: "fk_inquiries_sender")

  @@index([animal_id], map: "idx_inquiries_animal_id")
  @@index([receiver_id], map: "idx_inquiries_receiver_id")
  @@index([sender_id], map: "idx_inquiries_sender_id")
  @@index([status], map: "idx_inquiries_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model orders {
  id               String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  buyer_id         String        @db.VarChar(36)
  animal_id        String        @db.VarChar(36)
  amount           Decimal       @db.Decimal(12, 2)
  status           orders_status @default(PENDING)
  paystack_ref     String        @unique(map: "uq_orders_paystack_ref") @db.VarChar(200)
  paystack_channel String?       @db.VarChar(50)
  delivery_address String?       @db.Text
  delivery_state   String?       @db.VarChar(100)
  delivery_city    String?       @db.VarChar(100)
  notes            String?       @db.Text
  paid_at          DateTime?     @db.DateTime(0)
  created_at       DateTime      @default(now()) @db.DateTime(0)
  updated_at       DateTime      @default(now()) @db.DateTime(0)
  animals          animals       @relation(fields: [animal_id], references: [id], map: "fk_orders_animal")
  users            users         @relation(fields: [buyer_id], references: [id], map: "fk_orders_buyer")

  @@index([animal_id], map: "idx_orders_animal_id")
  @@index([buyer_id], map: "idx_orders_buyer_id")
  @@index([created_at], map: "idx_orders_created_at")
  @@index([status], map: "idx_orders_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model reviews {
  id         String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  user_id    String   @db.VarChar(36)
  animal_id  String   @db.VarChar(36)
  rating     Int      @db.TinyInt
  comment    String?  @db.Text
  created_at DateTime @default(now()) @db.DateTime(0)
  animals    animals  @relation(fields: [animal_id], references: [id], onDelete: Cascade, map: "fk_reviews_animal")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_reviews_user")

  @@unique([user_id, animal_id], map: "uq_reviews_user_animal")
  @@index([animal_id], map: "idx_reviews_animal_id")
  @@index([rating], map: "idx_reviews_rating")
}

model users {
  id                                     String      @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  firebase_uid                           String      @unique(map: "uq_users_firebase_uid") @db.VarChar(128)
  name                                   String      @db.VarChar(150)
  email                                  String      @unique(map: "uq_users_email") @db.VarChar(255)
  phone                                  String?     @db.VarChar(20)
  role                                   users_role  @default(BUYER)
  avatar_url                             String?     @db.Text
  address                                String?     @db.Text
  state                                  String?     @db.VarChar(100)
  city                                   String?     @db.VarChar(100)
  is_verified                            Boolean     @default(false)
  created_at                             DateTime    @default(now()) @db.DateTime(0)
  updated_at                             DateTime    @default(now()) @db.DateTime(0)
  animals                                animals[]
  cart                                   cart[]
  inquiries_inquiries_receiver_idTousers inquiries[] @relation("inquiries_receiver_idTousers")
  inquiries_inquiries_sender_idTousers   inquiries[] @relation("inquiries_sender_idTousers")
  orders                                 orders[]
  reviews                                reviews[]

  @@index([role], map: "idx_users_role")
  @@index([state], map: "idx_users_state")
}

enum animals_category {
  CATTLE
  GOAT
  SHEEP
  PIG
  POULTRY
  RABBIT
  HORSE
  OTHER
}

enum orders_status {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum inquiries_status {
  UNREAD
  READ
  REPLIED
}

enum users_role {
  BUYER
  SELLER
  ADMIN
}

enum animals_status {
  AVAILABLE
  SOLD
  RESERVED
}
